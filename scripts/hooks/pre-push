#!/bin/bash
# dev-loop-managed-hook v1 — WARNING ONLY, never blocks (exit 0 always).
# Reminds before a push to master/main to run the independent auto-review skill
# (see meta-repo AGENTS.md). Installed by scripts/install-dev-loop-hooks.mjs.
# Rationale: a change was once merged+pushed to master before any review ran —
# advisory memory alone didn't catch it because a different session did the push.
# Reinstall/update: re-run the installer. Remove: delete this file.

protected_pushed=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main) protected_pushed=1 ;;
  esac
done

if [ "$protected_pushed" = "1" ]; then
  repo="$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")"
  printf '\n\033[33m[dev-loop] Push to master/main in %s.\033[0m\n' "$repo" >&2
  printf '  Did this change get an independent review? If not, before merging next time:\n' >&2
  printf '    • run the auto-review skill on the change (blind reviewer, findings → dispositions)\n' >&2
  printf '  This is a reminder only — the push proceeds.\n\n' >&2
fi

exit 0
