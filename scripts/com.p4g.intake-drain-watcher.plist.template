<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.p4g.intake-drain-watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__META_CHECKOUT__/scripts/intake-drain-watcher.mjs</string>
    <string>--config</string>
    <string>__HOME__/.p4g-intake-watcher/config.json</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/.p4g-intake-watcher/watcher.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.p4g-intake-watcher/watcher.err.log</string>
</dict>
</plist>
